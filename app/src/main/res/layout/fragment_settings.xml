<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="20dp"
    android:baselineAligned="false"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginEnd="10dp">

        <LinearLayout
            style="@style/CardSection"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_color_music"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_background"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_color_music_enable"
                    android:textSize="16sp"
                    android:textColor="@color/on_surface"/>

                <Switch
                    android:id="@+id/switchColorMusic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/CardSection"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_service"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_background"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_service_status"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface_medium"
                    android:layout_marginEnd="12dp"/>

                <View
                    android:id="@+id/indicatorServiceStatus"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_indicator_online"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/textServiceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_running"
                    android:textSize="14sp"
                    android:textColor="@color/success"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestartService"
                style="@style/ControlButton.Large"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_restart_service"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScreenClean"
                style="@style/ControlButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_screen_clean"/>
        </LinearLayout>

        <LinearLayout
            style="@style/CardSection"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="0dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/textVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0"
                android:textSize="12sp"
                android:textColor="@color/on_surface_medium"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/textCarModelInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STARSHIP P145"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:textAllCaps="true"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/author_name"
                android:textSize="12sp"
                android:textColor="@color/on_surface_medium"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/textGithubLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/github_url"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginHorizontal="10dp">

        <LinearLayout
            style="@style/CardSection"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_language"/>

            <Spinner
                android:id="@+id/spinnerSystemLanguage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_background"
                android:popupBackground="@color/surface"/>
        </LinearLayout>

        <LinearLayout
            style="@style/CardSection"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_timezone"/>

            <Spinner
                android:id="@+id/spinnerTimezone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_background"
                android:popupBackground="@color/surface"/>
        </LinearLayout>

        <LinearLayout
            style="@style/CardSection"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="0dp"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_engineering_menus"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGeelyEngineering"
                style="@style/ControlButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_geely_engineering"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeveloperOptions"
                style="@style/ControlButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_developer_options"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <LinearLayout
            style="@style/CardSection"
            android:layout_height="match_parent"
            android:layout_marginBottom="0dp"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_android_settings"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWifiSettings"
                    style="@style/ControlButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_wifi_settings"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBluetoothSettings"
                    style="@style/ControlButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_bluetooth_settings"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisplaySettings"
                    style="@style/ControlButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_display_settings"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSoundSettings"
                    style="@style/ControlButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_sound_settings"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLanguageSettings"
                    style="@style/ControlButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_language_settings"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDateTimeSettings"
                    style="@style/ControlButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_datetime_settings"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAppsSettings"
                    style="@style/ControlButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_apps_settings"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStorageSettings"
                    style="@style/ControlButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_storage_settings"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecuritySettings"
                    style="@style/ControlButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_security_settings"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInputMethodSettings"
                    style="@style/ControlButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_input_method_settings"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
