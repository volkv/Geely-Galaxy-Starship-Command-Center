<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CardSection" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <style name="SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="ValueText" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/on_surface_medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ControlButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/on_surface</item>
        <item name="backgroundTint">@color/button_secondary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <style name="ControlButton.Primary">
        <item name="backgroundTint">@color/button_primary</item>
        <item name="android:textColor">@color/on_bright</item>
    </style>

    <style name="ControlButton.Accent">
        <item name="backgroundTint">@color/primary_dark</item>
        <item name="android:textColor">@color/on_bright</item>
    </style>

    <style name="ControlButton.Danger">
        <item name="backgroundTint">@color/button_danger</item>
        <item name="android:textColor">@color/on_bright</item>
    </style>

    <style name="ControlButton.Special">
        <item name="backgroundTint">@color/button_special</item>
        <item name="android:textColor">@color/on_bright</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ControlButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/on_surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <style name="ToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/on_surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="backgroundTint">@color/toggle_button_bg</item>
    </style>

    <style name="ToggleButton.Compact" parent="ToggleButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="StatusBar" parent="">
        <item name="android:background">@drawable/status_background</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="HeaderText" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SubHeaderText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/on_surface_medium</item>
    </style>

    <style name="AppTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="AppSubtitle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/cosmic_purple</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="StatusItemTitle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/on_surface_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="StatusItemValue" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.MaterialComponents.DayNight.Dialog.MinWidth" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="ControlButton.Large" parent="ControlButton">
        <item name="android:minHeight">72dp</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ControlButton.Large.Primary">
        <item name="backgroundTint">@color/button_primary</item>
        <item name="android:textColor">@color/on_bright</item>
    </style>

    <style name="ControlButton.Large.Accent">
        <item name="backgroundTint">@color/primary_dark</item>
        <item name="android:textColor">@color/on_bright</item>
    </style>

    <style name="ControlButton.Large.Danger">
        <item name="backgroundTint">@color/button_danger</item>
        <item name="android:textColor">@color/on_bright</item>
    </style>

    <style name="ToggleButton.Large" parent="ToggleButton">
        <item name="android:minHeight">72dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="NavigationTab" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_surface_medium</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="NavigationTab.Selected">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardSection.NoPadding" parent="CardSection">
        <item name="android:padding">0dp</item>
    </style>

    <style name="SectionTitle.Large" parent="SectionTitle">
        <item name="android:textSize">20sp</item>
    </style>
</resources>
